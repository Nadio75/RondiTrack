{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
  "Login": {
    "PermitLimit": 5,
    "WindowSeconds": 60
  },
  "Financial": {
    "PermitLimit": 30,
    "WindowSeconds": 60
  },
"CycleClosing": {
  "IntervalSeconds": 3600
},

"Housekeeping": {
  "Enabled": true,
  "RefreshTokenRetentionDays": 30,
  "IntervalHours": 24
}

}
}