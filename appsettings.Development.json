{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
  "Login": {
    "PermitLimit": 5,
    "WindowSeconds": 60
  },
  "Financial": {
    "PermitLimit": 30,
    "WindowSeconds": 60
  }
}
}